# MongoDB connection string (MongoDB Atlas). Use the SAME cluster as the frontend.
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
DB_NAME=booknook

# URL of the deployed (or local) Next.js frontend. Used for CORS and to fetch
# the public keys (JWKS) that verify the login tokens issued by BetterAuth.
# Local:      http://localhost:3000
# Production: https://your-booknook.vercel.app   (no trailing slash)
FRONTEND_URL=http://localhost:3000

PORT=5000
